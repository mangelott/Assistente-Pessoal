# Base de dados PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/assistente_pessoal?schema=public"

# Autenticação (utilizador único). Gera o hash com: npm run hash-password -- "a-tua-password"
AUTH_SECRET="define-um-valor-aleatorio-longo-aqui"
ADMIN_EMAIL="tu@exemplo.com"
ADMIN_PASSWORD_HASH=""

# Claude (Anthropic) — motor do assistente
ANTHROPIC_API_KEY=""

# Pesquisa de empresas (Google Places API). Sem esta chave, o assistente usa dados de exemplo.
GOOGLE_PLACES_API_KEY=""

# Rascunhos no Gmail (única forma de despachar emails). OAuth do Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
